---
interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  ctaText: string;
  ctaLink: string;
}

const { title, subtitle, description, ctaText, ctaLink } = Astro.props;
---

<aside class="not-prose my-10 overflow-hidden rounded-lg border border-emerald-500/20 bg-[#0a0a0a] shadow-[0_0_24px_rgba(16,185,129,0.08)]">
  <div class="flex items-center gap-2 border-b border-emerald-500/15 px-5 py-2.5 font-mono text-xs text-emerald-400/70">
    <span class="inline-block h-2 w-2 rounded-full bg-emerald-400/80"></span>
    <span>onefusionlab // systems</span>
  </div>
  <div class="px-5 py-6 sm:px-8 sm:py-7">
    <h3 class="font-mono text-base font-semibold tracking-tight text-zinc-100 sm:text-lg">{title}</h3>
    {subtitle && <p class="mt-1.5 text-sm text-zinc-400">{subtitle}</p>}
    {description && <p class="mt-3 text-sm leading-relaxed text-zinc-500">{description}</p>}
    <div class="mt-5">
      <a
        href={ctaLink}
        class="inline-flex items-center gap-2 rounded-md bg-emerald-500 px-4 py-2.5 font-mono text-sm font-semibold text-black transition-colors hover:bg-emerald-400"
      >
        {ctaText}
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</aside>
