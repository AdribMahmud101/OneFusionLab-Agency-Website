---
// Minimalist hero abstract — pure SVG, zero JS.
---

<figure class="not-prose my-8 overflow-hidden rounded-lg border border-border bg-[#0a0a0a]" aria-hidden="true">
  <svg viewBox="0 0 800 180" class="block h-auto w-full" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="pulse" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#06b6d4" stop-opacity="0"/>
        <stop offset="45%" stop-color="#06b6d4"/>
        <stop offset="55%" stop-color="#34d399"/>
        <stop offset="100%" stop-color="#34d399" stop-opacity="0"/>
      </linearGradient>
      <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
        <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#ffffff" stroke-opacity="0.05" stroke-width="1"/>
      </pattern>
    </defs>

    <rect width="800" height="180" fill="url(#grid)"/>

    <!-- carrier baseline -->
    <line x1="0" y1="90" x2="800" y2="90" stroke="#ffffff" stroke-opacity="0.12"/>

    <!-- pulse trace: python sine collapsing into square wave -->
    <path
      d="M 0 90 C 40 30, 80 150, 120 90 S 200 30, 240 90 S 320 150, 360 90 L 400 90 L 400 20 L 470 20 L 470 160 L 540 160 L 540 20 L 610 20 L 610 160 L 680 160 L 680 90 L 800 90"
      fill="none" stroke="url(#pulse)" stroke-width="2"/>

    <!-- transition marker -->
    <line x1="400" y1="10" x2="400" y2="170" stroke="#34d399" stroke-opacity="0.35" stroke-dasharray="3 5"/>
    <text x="408" y="26" font-family="ui-monospace, monospace" font-size="11" fill="#34d399" fill-opacity="0.9">MLIR</text>
    <text x="60" y="26" font-family="ui-monospace, monospace" font-size="11" fill="#06b6d4" fill-opacity="0.7">prototype</text>
    <text x="700" y="26" font-family="ui-monospace, monospace" font-size="11" fill="#34d399" fill-opacity="0.7">silicon</text>

    <!-- nodes -->
    <circle cx="240" cy="90" r="4" fill="#06b6d4"/>
    <circle cx="400" cy="90" r="4" fill="#34d399"/>
    <circle cx="680" cy="90" r="4" fill="#34d399"/>
  </svg>
</figure>
