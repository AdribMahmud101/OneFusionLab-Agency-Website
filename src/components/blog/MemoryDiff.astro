---
// Side-by-side Python vs Mojo memory-control comparison — static, zero JS.

const pythonCode = `# No ownership model. The GC decides.
kernel = build_matrix(1024)

# Shared mutable state across threads
result = reduce(kernel)   # GIL serializes this

# To free memory: hope refcounting works
del kernel  # ...eventually`;

const mojoCode = `# Explicit ownership, zero GC pauses
var kernel: Matrix = build_matrix(1024)

fn reduce(inout buf: Matrix) -> Float32:
    # borrowed read, in-place mutation
    return simd_reduce(buf[])

# Deterministic cleanup at scope exit
# owned | borrowed | inout — you decide`;
