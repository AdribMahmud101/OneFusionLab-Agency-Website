---
// MLIR compilation flowchart — static, zero JS. Python/GIL pipeline vs Mojo/MAX pipeline.

const legacy = [
  { label: "Python Prototype", sub: "fast iteration" },
  { label: "GIL / Runtime", sub: "overhead ceiling" },
  { label: "C++ / Rust Rewrite", sub: "weeks of rework" },
  { label: "Binary", sub: "one target" },
];

const mojo = [
  { label: "Mojo Source", sub: "write once" },
  { label: "MLIR", sub: "heterogeneous IR" },
  { label: "MAX Engine", sub: "auto-vectorize" },
  { label: "Any Silicon", sub: "H100 · Hexagon NPU" },
];
---

<figure class="not-prose my-8 overflow-hidden rounded-lg border border-border bg-[#0a0a0a] p-5 sm:p-6">
  <figcaption class="mb-5 font-mono text-xs uppercase tracking-widest text-zinc-500">
    fig. 01 — compilation pipeline
  </figcaption>

  <!-- Legacy pipeline -->
  <div class="flex flex-wrap items-stretch gap-y-3">
    {
      legacy.map((step, i) => (
        <>
          {i > 0 && (
            <span class="flex items-center px-1 font-mono text-sm text-red-400/70" aria-hidden="true">
              →
            </span>
          )}
          <div class="min-w-[120px] flex-1 rounded-md border border-red-400/25 bg-red-400/5 px-3 py-2.5 text-center">
            <p class="font-mono text-xs font-semibold text-zinc-200 sm:text-[13px]">{step.label}</p>
            <p class="mt-0.5 font-mono text-[10px] text-red-300/60">{step.sub}</p>
          </div>
        </>
      ))
    }
  </div>

  <div class="my-4 flex items-center gap-3">
    <span class="h-px flex-1 bg-border"></span>
    <span class="font-mono text-[10px] uppercase tracking-widest text-zinc-600">replaced by</span>
    <span class="h-px flex-1 bg-border"></span>
  </div>

  <!-- Mojo pipeline -->
  <div class="flex flex-wrap items-stretch gap-y-3">
    {
      mojo.map((step, i) => (
        <>
          {i > 0 && (
            <span class="flex items-center px-1 font-mono text-sm text-emerald-400/80" aria-hidden="true">
              →
            </span>
          )}
          <div class="min-w-[120px] flex-1 rounded-md border border-emerald-400/30 bg-emerald-400/5 px-3 py-2.5 text-center shadow-[0_0_12px_rgba(52,211,153,0.06)]">
            <p class="font-mono text-xs font-semibold text-zinc-100 sm:text-[13px]">{step.label}</p>
            <p class="mt-0.5 font-mono text-[10px] text-emerald-300/70">{step.sub}</p>
          </div>
        </>
      ))
    }
  </div>
</figure>
