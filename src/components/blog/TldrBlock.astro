---
interface Props {
  tldr: string;
}

const { tldr } = Astro.props;
---

<section
  class="not-prose my-6 rounded-lg border-l-4 border-primary bg-card/60 p-5"
  aria-label="Executive summary"
>
  <h2 class="font-mono text-xs font-semibold uppercase tracking-widest text-muted-foreground">
    TL;DR
  </h2>
  <p class="mt-2.5 text-base leading-relaxed text-foreground/90">{tldr}</p>
</section>
