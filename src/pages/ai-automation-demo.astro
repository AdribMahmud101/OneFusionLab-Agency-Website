---
import Layout from '../layouts/Layout.astro';
import { Button } from '@/components/ui/button';
import { SocialMediaDemo } from '@/components/demos/SocialMediaDemo';
---

<Layout>
	<main class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden px-4 pt-32 md:pt-24 text-center">
		
		<div class="relative z-10 max-w-7xl mx-auto space-y-12">
			<div class="space-y-4">
				<h1 class="text-5xl md:text-7xl font-bold tracking-tight font-outfit">
					<span class="bg-gradient-to-r from-cyan-400 via-blue-500 to-orange-500 bg-clip-text text-transparent">AI Automation</span>
					<br />
					<span class="text-foreground">Hub</span>
				</h1>
				
				<p class="text-lg md:text-xl text-muted-foreground max-w-2xl mx-auto">
					Select an autonomous agent to view its capabilities in action.
				</p>
			</div>

			{/* Demo Cards Grid */}
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 w-full px-4">
				
				{/* Social Media Automation Card */}
				<a href="/demos/social-media" class="group relative block h-full">
					<div class="absolute -inset-0.5 bg-gradient-to-r from-cyan-500 to-blue-600 rounded-2xl opacity-75 group-hover:opacity-100 transition duration-500 blur-sm group-hover:blur group-hover:inset-1"></div>
					<div class="relative h-full bg-white dark:bg-black rounded-xl p-8 flex flex-col items-start justify-between border border-zinc-200 dark:border-white/10 overflow-hidden shadow-xl dark:shadow-none transition-colors">
						
						<div class="absolute top-0 right-0 p-4 opacity-50 group-hover:opacity-100 transition-opacity duration-500">
							<div class="w-24 h-24 bg-cyan-500/10 dark:bg-cyan-500/20 rounded-full blur-2xl"></div>
						</div>

						<div class="space-y-4 z-10">
							<div class="w-12 h-12 rounded-lg bg-cyan-50 dark:bg-cyan-500/10 flex items-center justify-center border border-cyan-200 dark:border-cyan-500/20 group-hover:border-cyan-500/50 transition-colors">
								<svg class="w-6 h-6 text-cyan-600 dark:text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path>
								</svg>
							</div>
							
							<div>
								<h3 class="text-2xl font-bold text-zinc-900 dark:text-white group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors">Social Media Agent</h3>
								<p class="text-muted-foreground text-sm mt-2">Autonomous content generation for Twitter, LinkedIn, and Instagram.</p>
							</div>
						</div>

						<div class="mt-8 flex items-center text-sm font-medium text-cyan-600 dark:text-cyan-400 group-hover:translate-x-1 transition-transform">
							Launch Demo <span class="ml-2">→</span>
						</div>
					</div>
				</a>

                {/* Placeholder for Future Demos */}
				<div class="group relative block h-full opacity-50 cursor-not-allowed">
					<div class="relative h-full bg-zinc-50 dark:bg-zinc-900/50 rounded-xl p-8 flex flex-col items-start justify-between border border-zinc-200 dark:border-white/5 transition-colors">
						<div class="space-y-4">
							<div class="w-12 h-12 rounded-lg bg-zinc-200 dark:bg-white/5 flex items-center justify-center">
								<svg class="w-6 h-6 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
									<line x1="8" y1="21" x2="16" y2="21"></line>
									<line x1="12" y1="17" x2="12" y2="21"></line>
								</svg>
							</div>
							<div>
								<h3 class="text-2xl font-bold text-muted-foreground">Coming Soon</h3>
								<p class="text-zinc-500 dark:text-zinc-600 text-sm mt-2">More autonomous agents are being trained.</p>
							</div>
						</div>
					</div>
				</div>

			</div>

			<div class="pt-8">
				<a href="/">
					<Button variant="outline" className="text-lg px-8 py-6 rounded-full border-white/20 hover:bg-white/10">
						Back to Home
					</Button>
				</a>
			</div>
		</div>

		{/* Background Gradients */}
		<div class="absolute top-0 left-0 -z-10 h-full w-full bg-background overflow-hidden">
			<div class="absolute top-[-10%] right-[-5%] h-[500px] w-[500px] rounded-full bg-cyan-500/10 blur-[100px]" />
			<div class="absolute bottom-[-10%] left-[-5%] h-[500px] w-[500px] rounded-full bg-orange-500/10 blur-[100px]" />
		</div>
	</main>
</Layout>
