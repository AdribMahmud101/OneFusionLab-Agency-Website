---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blogs", ({ data }) => !data.isDraft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<Layout title="Blog | One Fusion Lab">
  <main class="mx-auto w-full max-w-4xl px-6 py-16 sm:py-20">
    <header>
      <p class="font-mono text-xs uppercase tracking-widest text-primary">~/devrel/blogs</p>
      <h1 class="mt-3 font-mono text-3xl font-bold tracking-tight sm:text-4xl">Engineering Notes</h1>
      <p class="mt-3 max-w-2xl text-muted-foreground">
        Deep dives on AI infrastructure, compilers, and edge deployment. Written by engineers,
        for engineers.
      </p>
    </header>

    <section aria-label="All posts" class="mt-12 space-y-6">
      {
        posts.map((post) => (
          <article class="group rounded-lg border border-border bg-card/50 p-6 transition-colors hover:border-primary/50">
            <header>
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-muted-foreground">
                <time datetime={post.data.publishDate.toISOString()}>
                  {post.data.publishDate.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  })}
                </time>
                <span aria-hidden="true">//</span>
                <span>{post.data.author}</span>
              </div>
              <h2 class="mt-2.5 text-xl font-semibold tracking-tight sm:text-2xl">
                <a href={`/blogs/${post.id}/`} class="hover:text-primary">
                  {post.data.title}
                </a>
              </h2>
            </header>
            <p class="mt-3 line-clamp-2 text-sm leading-relaxed text-muted-foreground">
              {post.data.tldr}
            </p>
            <footer class="mt-4 flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <span class="rounded-full border border-border px-2.5 py-0.5 font-mono text-[11px] text-muted-foreground">
                  {tag}
                </span>
              ))}
            </footer>
          </article>
        ))
      }
    </section>
  </main>
</Layout>
