---

import Layout from '../layouts/Layout.astro';
import { Orbit } from '@/components/Orbit';
import { Button } from '@/components/ui/button';
import { TechStack } from '@/components/TechStack';
import { BentoSection } from '@/components/BentoSection';
import { Footer } from '@/components/Footer';

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout>
	<main class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden px-4 md:px-0 pt-32 md:pt-24">
		<div class="container mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
			{/* Left Column: Orbit Animation */}
			<div class="flex justify-center md:justify-end order-2 md:order-1">
				<Orbit client:load className="scale-75 md:scale-100" />
			</div>

			{/* Right Column: Content */}
			<div class="flex flex-col items-center md:items-start text-center md:text-left order-1 md:order-2 space-y-6">
				<h1 class="text-5xl md:text-7xl font-bold tracking-tight font-outfit">
					<span class="bg-gradient-to-r from-zinc-900 to-zinc-500 dark:from-white dark:to-white/50 bg-clip-text text-transparent">The Fusion of</span>
					<br />
					<span class="bg-gradient-to-r from-cyan-400 via-blue-500 to-orange-500 bg-clip-text text-transparent">Grit and Genius</span>
				</h1>
				<p class="text-lg md:text-xl text-muted-foreground max-w-lg">
"We engineer self-driving business infrastructures by fusing autonomous agents with enterprise <span class="text-cyan-400 drop-shadow-[0_0_10px_rgba(34,211,238,0.6)] font-semibold">automation</span>. Stop managing static workflows and start orchestrating intelligence."
				</p>
				<div class="flex flex-col sm:flex-row gap-4">
					<a href="/ai-automation-demo">
						<Button className="bg-cyan-600 hover:bg-cyan-500 text-white text-lg px-8 py-6 rounded-full shadow-[0_0_20px_rgba(6,182,212,0.5)] hover:shadow-[0_0_30px_rgba(6,182,212,0.7)] transition-all duration-300">
							View Demo
						</Button>
					</a>
					<Button variant="outline" className="text-lg px-8 py-6 rounded-full border-white/20 hover:bg-white/10">
						Learn More
					</Button>
				</div>
			</div>
		</div>
		
		<TechStack client:load />
		<BentoSection client:load />
		

		{/* Background Gradients */}
		<div class="absolute top-0 left-0 -z-10 h-full w-full bg-background overflow-hidden">
			<div class="absolute top-[-10%] right-[-5%] h-[500px] w-[500px] rounded-full bg-cyan-500/10 blur-[100px]" />
			<div class="absolute bottom-[-10%] left-[-5%] h-[500px] w-[500px] rounded-full bg-orange-500/10 blur-[100px]" />
		</div>
	</main>
	<Footer client:load />
</Layout>
